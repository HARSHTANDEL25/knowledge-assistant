# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Groq (LLM) + Hugging Face (embeddings)
GROQ_API_KEY=
HF_TOKEN=

# Google Drive sync (service account — no Workspace admin required)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
DRIVE_HR_FOLDER_ID=
DRIVE_IT_FOLDER_ID=

# Confluence sync
CONFLUENCE_BASE_URL=
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
